// api/index.js
const axios = require('axios');
const { HttpsProxyAgent } = require('https-proxy-agent');

// Use environment variable for proxy, with fallback
const PROXY_URL = process.env.PROXY_URL || 'http://pkg-royal-country-any:jsewamsl1rrirlt9@standard.vital-proxies.com:8603';

// ─── Helper: random delay ────────────────────────────────────
function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

function randomDelay() {
    // 2 to 5 seconds – makes it look human
    const min = 2000;
    const max = 5000;
    return Math.floor(Math.random() * (max - min + 1)) + min;
}

// ─── Extraction logic (enhanced) ────────────────────────────

function extractFromHTML(html, originalUrl) {
    // Helper: get query parameter
    function getParam(url, key) {
        const m = url.match(new RegExp('[?&]' + key + '=([^&]*)'));
        return m ? decodeURIComponent(m[1]) : null;
    }

    // Helper: search scripts (with better regex)
    function findInScripts(pattern) {
        const matches = html.match(/<script[^>]*>([\s\S]*?)<\/script>/gi);
        if (!matches) return null;
        for (const script of matches) {
            const text = script.replace(/<[^>]*>/g, '');
            const m = text.match(pattern);
            if (m && m[1] && m[1].includes('http')) return m[1];
        }
        return null;
    }

    // ── Linkvertise ──────────────────────────────────────────
    if (originalUrl.includes('linkvertise.com')) {
        // landing-page-data
        const dataMatch = html.match(/<div\s+id="landing-page-data"[^>]*>([\s\S]*?)<\/div>/i);
        if (dataMatch) {
            try {
                const data = JSON.parse(dataMatch[1]);
                if (data.destination) return data.destination;
            } catch (_) {}
        }

        // inline script data
        const dest = findInScripts(/["']destination["']\s*:\s*["']([^"']+)["']/);
        if (dest) return dest;

        // window.location redirect
        const loc = findInScripts(/window\.location\s*=\s*["']([^"']+)["']/);
        if (loc && !loc.includes('linkvertise')) return loc;

        // meta refresh
        const meta = html.match(/<meta\s+http-equiv="refresh"\s+content="[^"]*url=([^"]+)"\s*\/?>/i);
        if (meta) return decodeURIComponent(meta[1]);

        // any external link (skip premium/upgrade)
        const linkMatch = html.match(/<a[^>]+href="(https?:\/\/[^"]+)"[^>]*>/i);
        if (linkMatch) {
            const href = linkMatch[1];
            if (href && !href.includes('linkvertise') && !href.includes('premium')) return href;
        }
    }

    // ── Work.ink ─────────────────────────────────────────────
    if (originalUrl.includes('work.ink')) {
        const dataAttr = html.match(/<[^>]+data-redirect="([^"]+)"[^>]*>/i) ||
                         html.match(/<[^>]+data-url="([^"]+)"[^>]*>/i) ||
                         html.match(/<[^>]+data-destination="([^"]+)"[^>]*>/i);
        if (dataAttr) {
            const u = dataAttr[1];
            if (u.startsWith('http') && !u.includes('work.ink')) return u;
        }

        const loc = findInScripts(/window\.location\s*=\s*['"]([^'"]+)['"]/);
        if (loc && !loc.includes('work.ink')) return loc;

        const meta = html.match(/<meta\s+http-equiv="refresh"\s+content="[^"]*url=([^"]+)"\s*\/?>/i);
        if (meta) return decodeURIComponent(meta[1]);

        // atob/decodeURIComponent
        const atobMatch = html.match(/atob\s*\(\s*['"]([^'"]+)['"]\s*\)/);
        if (atobMatch) {
            try {
                const decoded = Buffer.from(atobMatch[1], 'base64').toString();
                if (decoded.includes('http') && !decoded.includes('work.ink')) return decoded;
            } catch (_) {}
        }
    }

    // ── LootLabs family ──────────────────────────────────────
    if (originalUrl.includes('lootdest') || originalUrl.includes('loot-link') || originalUrl.includes('lootlabs') ||
        originalUrl.includes('ultra-links') || originalUrl.includes('lootboost') || originalUrl.includes('fast-links')) {
        const urlParam = getParam(originalUrl, 'url') || getParam(originalUrl, 'r') ||
                         getParam(originalUrl, 'dest') || getParam(originalUrl, 'destination');
        if (urlParam && urlParam.startsWith('http') && !urlParam.includes(originalUrl.split('/')[2])) {
            return urlParam;
        }

        const dataAttr2 = html.match(/<[^>]+data-url="([^"]+)"[^>]*>/i) ||
                          html.match(/<[^>]+data-destination="([^"]+)"[^>]*>/i) ||
                          html.match(/<[^>]+data-redirect="([^"]+)"[^>]*>/i);
        if (dataAttr2) {
            const u = dataAttr2[1];
            if (u.startsWith('http')) return u;
        }
    }

    // ── Rekonise ─────────────────────────────────────────────
    if (originalUrl.includes('rekonise.com')) {
        const dataAttr3 = html.match(/<[^>]+data-url="([^"]+)"[^>]*>/i);
        if (dataAttr3) {
            const u = dataAttr3[1];
            if (u.startsWith('http')) return u;
        }
        const loc2 = findInScripts(/window\.location\.href\s*=\s*["']([^"']+)["']/);
        if (loc2 && !loc2.includes('rekonise')) return loc2;
    }

    // ── Lockr ────────────────────────────────────────────────
    if (originalUrl.includes('lockr.so') || originalUrl.includes('lockr.net')) {
        const urlParam2 = getParam(originalUrl, 'url') || getParam(originalUrl, 'r');
        if (urlParam2 && urlParam2.startsWith('http')) return urlParam2;

        const meta2 = html.match(/<meta\s+http-equiv="refresh"\s+content="[^"]*url=([^"]+)"\s*\/?>/i);
        if (meta2) return decodeURIComponent(meta2[1]);
    }

    // ── Sub2Unlock ───────────────────────────────────────────
    if (originalUrl.includes('sub2unlock.com')) {
        const btn = html.match(/<[^>]+data-url="([^"]+)"[^>]*>/i);
        if (btn) {
            const u = btn[1];
            if (u.startsWith('http')) return u;
        }
        const dest3 = findInScripts(/["']url["']\s*:\s*["']([^"']+)["']/);
        if (dest3 && dest3.startsWith('http')) return dest3;
    }

    // ── ADF.ly ────────────────────────────────────────────────
    if (originalUrl.includes('adf.ly')) {
        const skip = html.match(/<a[^>]+id="skip_button"[^>]+href="([^"]+)"[^>]*>/i);
        if (skip) {
            const u = skip[1];
            if (u.startsWith('http') && !u.includes('adf.ly')) return u;
        }
        const loc3 = findInScripts(/window\.location\s*=\s*["']([^"']+)["']/);
        if (loc3 && !loc3.includes('adf.ly')) return loc3;
    }

    // ── Show.co ──────────────────────────────────────────────
    if (originalUrl.includes('show.co')) {
        const dataAttr4 = html.match(/<[^>]+data-destination="([^"]+)"[^>]*>/i) ||
                          html.match(/<[^>]+data-url="([^"]+)"[^>]*>/i);
        if (dataAttr4) {
            const u = dataAttr4[1];
            if (u.startsWith('http')) return u;
        }
        const iframe = html.match(/<iframe[^>]+src="([^"]+)"[^>]*>/i);
        if (iframe) {
            const src = iframe[1];
            const urlParam3 = getParam(src, 'url') || getParam(src, 'dest');
            if (urlParam3 && urlParam3.startsWith('http')) return urlParam3;
        }
    }

    // ── Exe.io / Ouo.io / ShrinkMe ──────────────────────────
    if (originalUrl.includes('exe.io') || originalUrl.includes('ouo.io') || originalUrl.includes('shrinkme.io')) {
        const urlParam4 = getParam(originalUrl, 'url') || getParam(originalUrl, 'r') || getParam(originalUrl, 'dest');
        if (urlParam4 && urlParam4.startsWith('http')) return urlParam4;

        const meta3 = html.match(/<meta\s+http-equiv="refresh"\s+content="[^"]*url=([^"]+)"\s*\/?>/i);
        if (meta3) return decodeURIComponent(meta3[1]);
    }

    // ── Cuttlinks ─────────────────────────────────────────────
    if (originalUrl.includes('cuttlinks.com')) {
        const urlParam5 = getParam(originalUrl, 'url') || getParam(originalUrl, 'dest');
        if (urlParam5 && urlParam5.startsWith('http')) return urlParam5;

        const meta4 = html.match(/<meta\s+http-equiv="refresh"\s+content="[^"]*url=([^"]+)"\s*\/?>/i);
        if (meta4) return decodeURIComponent(meta4[1]);
    }

    // ── FALLBACK ─────────────────────────────────────────────
    const params = ['url', 'r', 'dest', 'destination', 'redirect', 'link', 'to'];
    for (const p of params) {
        const val = getParam(originalUrl, p);
        if (val && val.startsWith('http') && !val.includes(originalUrl.split('/')[2])) {
            return val;
        }
    }

    // Try any external link (excluding the current domain)
    const linkMatch2 = html.match(/<a[^>]+href="(https?:\/\/[^"]+)"[^>]*>/i);
    if (linkMatch2) {
        const href = linkMatch2[1];
        if (href && !href.includes(originalUrl.split('/')[2]) && !href.includes('premium')) {
            return href;
        }
    }

    return null;
}

// ─── Serverless function ────────────────────────────────────

module.exports = async (req, res) => {
    // Only accept POST
    if (req.method !== 'POST') {
        res.status(405).json({ error: 'Method not allowed' });
        return;
    }

    const { link } = req.body;
    if (!link) {
        res.status(400).json({ error: 'Missing "link" parameter' });
        return;
    }

    // Normalize URL
    let url = link.trim();
    if (!url.startsWith('http://') && !url.startsWith('https://')) {
        url = 'https://' + url;
    }

    try {
        new URL(url);
    } catch (_) {
        res.status(400).json({ error: 'Invalid URL format' });
        return;
    }

    // ─── Check if it's a shortener ──────────────────────────
    const shortenerDomains = [
        'linkvertise.com', 'work.ink', 'lootdest.org', 'loot-link.com',
        'loot-links.com', 'lootlabs.gg', 'ultra-links.net', 'lootboost.net',
        'fast-links.org', 'rekonise.com', 'lockr.so', 'lockr.net',
        'cuttlinks.com', 'adf.ly', 'sub2unlock.com', 'show.co',
        'exe.io', 'ouo.io', 'shrinkme.io', 'shrtslug.biz', 'biovetro.net',
        'technons.com', 'yrtourguide.com', 'tournguide.com'
    ];
    const domain = url.replace(/^https?:\/\//, '').split('/')[0].split(':')[0];
    const isShortener = shortenerDomains.some(d => domain.includes(d));

    if (!isShortener) {
        // Not a shortener – return directly (with a small delay to simulate work)
        await sleep(randomDelay());
        res.json({
            success: true,
            destination: url,
            message: 'Not a shortened link — already direct.',
            bypassed: false
        });
        return;
    }

    // ─── Fetch via proxy ──────────────────────────────────────

    try {
        // Create proxy agent
        const proxy = new URL(PROXY_URL);
        const agent = new HttpsProxyAgent(proxy);

        // ─── Fetch with full browser headers ──────────────────
        const response = await axios.get(url, {
            httpsAgent: agent,
            httpAgent: agent,
            timeout: 35000,
            headers: {
                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36',
                'Accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7',
                'Accept-Language': 'en-US,en;q=0.9',
                'Accept-Encoding': 'gzip, deflate, br',
                'Connection': 'keep-alive',
                'Upgrade-Insecure-Requests': '1',
                'Sec-Fetch-Dest': 'document',
                'Sec-Fetch-Mode': 'navigate',
                'Sec-Fetch-Site': 'none',
                'Sec-Fetch-User': '?1',
                'Cache-Control': 'max-age=0',
                'Sec-Ch-Ua': '"Not_A Brand";v="8", "Chromium";v="120", "Google Chrome";v="120"',
                'Sec-Ch-Ua-Mobile': '?0',
                'Sec-Ch-Ua-Platform': '"Windows"',
            },
            maxRedirects: 5,
            validateStatus: status => status < 400
        });

        const html = response.data;

        // ─── Log for debugging (remove in production) ────────
        console.log('Status:', response.status);
        console.log('Content-Type:', response.headers['content-type']);
        console.log('HTML preview:', html.substring(0, 300));

        // ─── Extract destination ─────────────────────────────
        const destination = extractFromHTML(html, url);

        // ─── Simulate human delay (2-5 seconds) ──────────────
        await sleep(randomDelay());

        if (destination && destination.startsWith('http')) {
            res.json({
                success: true,
                destination: destination,
                message: 'Successfully unlocked!',
                bypassed: true
            });
        } else {
            // Check if we got an anti-bot page
            if (html.includes('antiblock') || html.includes('adblock') || html.includes('captcha')) {
                res.status(500).json({
                    success: false,
                    error: 'The link is protected by anti-bot measures. Try a different proxy or method.'
                });
            } else {
                res.status(500).json({
                    success: false,
                    error: 'Could not extract destination link. The page structure may have changed.'
                });
            }
        }
    } catch (err) {
        console.error('Error:', err.message);
        res.status(500).json({
            success: false,
            error: 'Failed to fetch or extract: ' + err.message
        });
    }
};
